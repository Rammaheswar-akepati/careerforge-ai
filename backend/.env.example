# Local API settings. Keep credentials out of this file.
APP_NAME=CareerForge AI API
ENVIRONMENT=development

# This file is loaded automatically when copied to the ignored backend/.env file.
# Process environment variables take precedence.
# Replace YOUR_PASSWORD only in the local backend/.env file or process environment.
# URL-encode password characters that have special meaning in URLs.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/careerforge
